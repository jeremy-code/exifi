  "files_exif_info_title": "Exif information",
  "files_exif_info_byte_order": "Byte order",
  "files_exif_byte_order": [
    {
      "declarations": ["input byteOrder"],
      "selectors": ["byteOrder"],
      "match": {
        "byteOrder=MOTOROLA": "Big-endian",
        "byteOrder=INTEL": "Little-endian",
        "byteOrder=*": "Unknown"
      }
    }
  ],
  "files_exif_info_data_type": "Data type",
  "files_exif_info_makernote": "Makernote",
  "files_exif_info_makernote_entries": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} entry",
        "countPlural=other": "{count} entries"
      }
    }
  ],
  "files_exif_info_makernote_unable_to_parse": "Unable to parse",
  "files_exif_info_thumbnail": "Thumbnail",
  "files_exif_info_number_of_entries": "Number of entries",
  "files_exif_data_type": [
    {
      "declarations": ["input dataType"],
      "selectors": ["dataType"],
      "match": {
        "dataType=UNCOMPRESSED_CHUNKY": "Uncompressed chunky",
        "dataType=UNCOMPRESSED_PLANAR": "Uncompressed planar",
        "dataType=UNCOMPRESSED_YCC": "Uncompressed YCC",
        "dataType=COMPRESSED": "Compressed",
        "dataType=UNKNOWN": "Unknown",
        "dataType=*": "Unknown"
      }
    }
  ],
  "files_exif_date_time": "Date and Time",
  "files_exif_date_time_original": "Date and Time (Original)",
  "files_exif_date_time_digitized": "Date and Time (Digitized)",
  "files_exif_date_time_gps": "Date and Time (GPS)",
  "files_tab_unnamed_file": "Unnamed File",
  "files_tab_new_tab": "New Tab",
  "files_tab_close": "Close tab",
  "files_tabs_add_tab": "New tab",
  "files_tab_panel_heading": "Upload file to view Exif metadata",
  "files_tab_panel_demo": "For a quick demo, {#demoLink}click here{/demoLink}.",
  "files_tab_panel_or": "OR",
  "files_dialog_unsaved_changes_title": "Unsaved changes",
  "files_dialog_unsaved_changes_description": "You have unsaved changes that will be lost if you proceed.",
