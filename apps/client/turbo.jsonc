{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["codegen"],
      "env": ["ANALYZE", "DEV", "URL", "BASE_URL", "COMMIT_REF"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!.env.example"]
    },
    "codegen": {
      "dependsOn": ["codegen:openapi"]
    },
    "codegen:openapi": {
      "inputs": ["openapi-ts.config.ts"],
      "outputs": ["src/generated/nominatim/**/*"]
    },
    "dev": {
      "dependsOn": ["@exifi/image-utils#build"],
      "env": ["PORT", "URL", "BASE_URL", "COMMIT_REF"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!.env.example"]
    }
  }
}
