{
  "name": "@exifi/image-utils",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./imageUtils": {
      "types": "./dist/imageUtils.d.ts",
      "node": "./dist/imageUtils.node.js",
      "browser": "./dist/imageUtils.web.js",
      "default": "./dist/imageUtils.web.js"
    },
    "./imageUtils.wasm": "./dist/imageUtils.wasm"
  },
  "scripts": {
    "build": "./scripts/build.sh",
    "format": "find -E src -regex '.*\\.(cpp|h)' | xargs clang-format -i"
  }
}
