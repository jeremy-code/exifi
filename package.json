{
  "name": "exifi",
  "version": "0.0.0",
  "description": "Local-only Exif viewer and editor",
  "keywords": [
    "editor",
    "exif",
    "exif-editor",
    "exif-viewer",
    "metadata",
    "vieweer"
  ],
  "homepage": "https://github.com/jeremy-code/exifi#readme",
  "bugs": "https://github.com/jeremy-code/exifi/issues",
  "license": "MIT",
  "author": "Jeremy Nguyen <hi@jeremy.ng> (https://jeremy.ng)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremy-code/exifi.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest --run",
    "test:watch": "vitest",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@exifi/oxlint-config": "workspace:*",
    "@exifi/tsconfig": "workspace:*",
    "@types/node": "^24.13.4",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    },
    "runtime": [
      {
        "name": "node",
        "version": "24.21.0",
        "onFail": "download"
      }
    ]
  }
}
