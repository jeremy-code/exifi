{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {
    "groups": [
      ["react", "builtin"],
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"]
    ],
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": [
          "react",
          "react-dom",
          "react-dom/server",
          "react-dom/client",
          "react-dom/static"
        ]
      }
    ],
    "internalPattern": ["@exifi/"],
    "ignoreCase": false,
    "newlinesBetween": true,
    "order": "asc"
  },
  "sortPackageJson": true,
  "sortTailwindcss": {
    "stylesheet": "./packages/ui/src/globals.css",
    "functions": ["cx", "cn", "cnMerge", "tv", "twMerge"]
  },
  "ignorePatterns": ["**/src/generated"]
}
