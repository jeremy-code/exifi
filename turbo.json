{
  "$schema": "./node_modules/turbo/schema.json",
  "globalEnv": ["NODE_ENV"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@exifi/client#build": {
      "dependsOn": ["@exifi/image-utils#build"],
      "env": ["ANALYZE", "DEV", "URL", "BASE_URL", "COMMIT_REF"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!.env.example"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "@exifi/client#lint": {
      "dependsOn": ["@exifi/client#codegen"]
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": true
    },
    "@exifi/client#dev": {
      "env": ["PORT", "URL", "BASE_URL", "COMMIT_REF"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!.env.example"]
    },
    "@exifi/image-utils#dev": {
      "dependsOn": ["build"]
    },
    "test": {
      "cache": false,
      "persistent": true
    },
    "@exifi/client#test": {
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!.env.example"]
    },

    "@exifi/client#codegen": {
      "outputs": ["src/generated/**/*"],
      "inputs": ["redocly.yaml"]
    }
  }
}
